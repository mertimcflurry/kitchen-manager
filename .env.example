# Kopie als .env anlegen und ausfüllen. .env gehört nicht in Git.

# SQLite-Datei, relativ zum Projektwurzelverzeichnis.
# Liegt unter data/, damit sie im Container als Bind-Mount überlebt.
DATABASE_URL=data/kitchen.db

# Anthropic API — Key von console.anthropic.com.
# Wird getrennt vom Claude-Abo abgerechnet (Prepaid-Guthaben).
# NIEMALS ins Frontend, nur in src/lib/server/ai/ verwenden.
ANTHROPIC_API_KEY=

# Modell für Bon-Parsing und Rezeptvorschlag.
# claude-opus-5 ist der Default. Günstigere Alternativen, falls die
# Erkennungsqualität an echten Bons ausreicht:
#   claude-sonnet-5   ~2 ct/Bon
#   claude-haiku-4-5  ~0,7 ct/Bon
ANTHROPIC_MODEL=claude-opus-5
